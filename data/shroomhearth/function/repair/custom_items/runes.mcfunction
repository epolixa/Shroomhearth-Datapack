# rune of armor
execute store result score @s repairable run clear @s #shroomhearth:rune[custom_data={"shroomhearth_id":"rune_of_armor"}] 0
clear @s[scores={repairable=1..}] #shroomhearth:rune[custom_data={"shroomhearth_id":"rune_of_armor"}] 1
loot give @s[scores={repairable=1..}] loot shroomhearth:runes/rune_of_armor
tag @s[scores={repairable=1..}] add repaired
scoreboard players reset @s repairable

